<?xml version="1.0"?>
<!--
/**
 * Injects the free-shipping banner above the storefront header on every page.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="page.wrapper">
            <block
                class="Demo\FreeshippingBanner\Block\Banner"
                name="demo.freeshipping.banner"
                template="Demo_FreeshippingBanner::banner.phtml"
                before="-"
            />
        </referenceContainer>
    </body>
</page>
